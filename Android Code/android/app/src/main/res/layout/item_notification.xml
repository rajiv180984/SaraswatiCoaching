<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_subtle"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <!-- Type icon circle -->
    <FrameLayout
        android:id="@+id/fl_icon_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_brand_circle">

        <ImageView
            android:id="@+id/iv_type_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@color/white" />
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_m" />

        <TextView
            android:id="@+id/tv_notif_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_s" />

        <TextView
            android:id="@+id/tv_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_label_m" />
    </LinearLayout>

    <!-- Unread dot -->
    <View
        android:id="@+id/view_unread_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_brand_circle"
        android:backgroundTint="@color/reliance_blue"
        android:visibility="gone" />

</LinearLayout>
