<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_minimal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otp_title"
            android:textAppearance="@style/TextAppearance.Saraswati.Headline" />

        <!-- Subtitle: "We sent a 4-digit code to +91 XXXXXX" -->
        <TextView
            android:id="@+id/otp_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Saraswati.BodySecondary"
            tools:text="We sent a 4-digit code to +91 98765 43210" />

        <!-- Change number link -->
        <TextView
            android:id="@+id/change_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_xxs"
            android:text="@string/otp_change_number"
            android:textAppearance="@style/TextAppearance.Saraswati.Label"
            android:textColor="@color/reliance_blue"
            android:textSize="@dimen/text_body_m" />

        <!-- ── 4 OTP boxes ── -->
        <LinearLayout
            android:id="@+id/otp_boxes_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_1"
                android:layout_width="64dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_otp_box"
                android:fontFamily="@font/jiotype_var"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:textFontWeight="700"
                android:textSize="@dimen/text_headline_s" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_2"
                android:layout_width="64dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_otp_box"
                android:fontFamily="@font/jiotype_var"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textFontWeight="700"
                android:textSize="@dimen/text_headline_s" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_3"
                android:layout_width="64dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_otp_box"
                android:fontFamily="@font/jiotype_var"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textFontWeight="700"
                android:textSize="@dimen/text_headline_s" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/otp_4"
                android:layout_width="64dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_otp_box"
                android:fontFamily="@font/jiotype_var"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textFontWeight="700"
                android:textSize="@dimen/text_headline_s" />

        </LinearLayout>

        <!-- Error message (wrong OTP / attempts exceeded) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_error_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_about"
                android:tint="@color/negative"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_otp_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/negative"
                android:textSize="@dimen/text_body_s"
                android:visibility="gone"
                tools:text="Incorrect OTP. 2 attempts remaining."
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Resend timer / link -->
        <TextView
            android:id="@+id/resend_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_l"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Saraswati.Body"
            android:textColor="@color/text_tertiary"
            tools:text="Resend OTP in 30s" />

        <!-- Verify button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verify_button"
            style="@style/Saraswati.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_l"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/otp_verify" />

        <!-- Demo hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_m"
            android:text="Demo OTP: 1234"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_label_m" />

    </LinearLayout>
</ScrollView>
