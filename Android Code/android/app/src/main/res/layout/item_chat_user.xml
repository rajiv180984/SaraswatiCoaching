<?xml version="1.0" encoding="utf-8"?>
<!-- User message — right-aligned blue bubble -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_xxs">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_user"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:maxWidth="260dp">

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_m"
            android:lineSpacingMultiplier="1.3"
            tools:text="How do I solve a quadratic equation?" />

        <TextView
            android:id="@+id/msg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_label_s"
            tools:text="3:42 PM" />
    </LinearLayout>

</LinearLayout>
