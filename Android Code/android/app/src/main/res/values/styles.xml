<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ Text appearances (JDS scale) ============ -->
    <style name="TextAppearance.Saraswati.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_display_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Saraswati.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Saraswati.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Saraswati.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextAppearance.Saraswati.BodySecondary" parent="TextAppearance.Saraswati.Body">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Saraswati.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_label_m</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Saraswati.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_l</item>
        <item name="cornerRadius">@dimen/radius_component</item>
        <item name="backgroundTint">@color/reliance_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
    </style>

    <style name="Saraswati.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_l</item>
        <item name="cornerRadius">@dimen/radius_component</item>
        <item name="strokeColor">@color/stroke_moderate</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Saraswati.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_l</item>
        <item name="android:textColor">@color/reliance_blue</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ============ Inputs ============ -->
    <style name="Saraswati.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_component</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_component</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_component</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_component</item>
        <item name="boxStrokeColor">@color/reliance_blue</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_emphasized</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- ============ ShapeableImageView — circle ============ -->
    <style name="ShapeAppearance.App.CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============ Cards ============ -->
    <style name="Saraswati.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="cardBackgroundColor">@color/surface_subtle</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Saraswati.Card.Hero" parent="Saraswati.Card">
        <item name="cardBackgroundColor">@color/saffron</item>
        <item name="cardElevation">@dimen/elevation_medium</item>
    </style>

</resources>
