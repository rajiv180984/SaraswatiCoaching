<?xml version="1.0" encoding="utf-8"?>
<!--
    Platform-level counterpart to TlsConfig.

    base-config: no cleartext traffic anywhere in the app, for any component that does not
    go through OkHttp (WebView, image loaders, tooling).

    domain-config: the auth-service deployment presents a self-signed certificate, so the
    bundled certificates are added as trust anchors for that host alongside the system CAs.
    Nothing here relaxes anything for any other domain.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <!-- Deployment -->
        <domain includeSubdomains="false">3.108.167.166</domain>
        <!-- Local runs: emulator host loopback, and adb reverse on a device -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/auth_service" />
            <certificates src="@raw/saraswati_auth" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

</network-security-config>
