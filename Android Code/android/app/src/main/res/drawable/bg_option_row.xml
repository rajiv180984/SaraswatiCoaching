<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/reliance_blue_light" />
            <stroke android:width="2dp" android:color="@color/reliance_blue" />
            <corners android:radius="@dimen/radius_component" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_subtle" />
            <stroke android:width="1dp" android:color="@color/stroke_minimal" />
            <corners android:radius="@dimen/radius_component" />
        </shape>
    </item>
</selector>
