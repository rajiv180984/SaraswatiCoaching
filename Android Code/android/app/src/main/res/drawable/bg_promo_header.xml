<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base blue gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1646BF"
                android:centerColor="#0F35A0"
                android:endColor="#0A2475"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle decorative circle — top-right -->
    <item
        android:top="-60dp"
        android:right="-60dp"
        android:bottom="60dp"
        android:left="60dp">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF" />
        </shape>
    </item>

    <!-- Subtle decorative circle — bottom-left -->
    <item
        android:top="60dp"
        android:right="60dp"
        android:bottom="-60dp"
        android:left="-60dp">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
        </shape>
    </item>

</layer-list>
