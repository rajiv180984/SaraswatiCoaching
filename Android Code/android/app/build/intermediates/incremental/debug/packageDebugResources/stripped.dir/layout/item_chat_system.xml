<?xml version="1.0" encoding="utf-8"?>
<!-- AI / System message — left-aligned grey bubble with avatar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_xxs">

    <!-- AI avatar circle -->
    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="@drawable/bg_brand_circle"
        android:text="AI"
        android:textColor="@color/reliance_blue"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_marginTop="2dp" />

    <!-- Bubble -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_chat_system"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:maxWidth="260dp">

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_m"
            android:lineSpacingMultiplier="1.3"
            tools:text="Great question! Here is how to solve a quadratic equation…" />

        <TextView
            android:id="@+id/msg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_label_s"
            tools:text="3:42 PM" />
    </LinearLayout>

</LinearLayout>
