<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_minimal">

    <!-- ── Online / Offline toggle ── -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:layout_marginTop="@dimen/space_m"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_online"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_m"
            android:layout_weight="1"
            android:text="@string/tests_online" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_offline"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_m"
            android:layout_weight="1"
            android:text="@string/tests_offline" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ── Subject filter chips ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_m">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xxs"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- ── Test list ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tests_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingBottom="@dimen/space_l"
        android:clipToPadding="false" />

</LinearLayout>
