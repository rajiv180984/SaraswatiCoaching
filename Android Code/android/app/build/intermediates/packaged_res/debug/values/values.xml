    <style name="Saraswati.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_l</item>
        <item name="cornerRadius">@dimen/radius_component</item>
        <item name="backgroundTint">@color/reliance_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
    </style>
    <style name="Saraswati.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_l</item>
        <item name="cornerRadius">@dimen/radius_component</item>
        <item name="strokeColor">@color/stroke_moderate</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:fontFamily">@font/jiotype_var</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Saraswati.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
