<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_minimal">

    <!-- ── Material type filter row ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_m">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xxs"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- ── Subject filter row ── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/space_m">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xxs"
            app:chipSpacingHorizontal="@dimen/space_xs"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- ── Materials list ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/materials_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingBottom="@dimen/space_l"
        android:clipToPadding="false" />

</LinearLayout>
