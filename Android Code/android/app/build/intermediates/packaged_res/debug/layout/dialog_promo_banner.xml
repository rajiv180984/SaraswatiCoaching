<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ════════════════════════════════════
             HEADER — gradient blue
             ════════════════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_promo_header"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Close button (top-right) -->
            <FrameLayout
                android:id="@+id/btn_promo_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_promo_close"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white" />
            </FrameLayout>

            <!-- Center content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- "SPECIAL OFFER" badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_promo_badge"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="⭐  SPECIAL OFFER  ⭐"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <!-- Discount headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="25% Off"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/jiotype_var"
                    android:lineSpacingMultiplier="1.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="on Annual Batch Enrollment"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp" />

                <!-- Promo code pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_promo_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use code: "
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SARAS25"
                        android:textColor="@color/saffron"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/jiotype_var" />
                </LinearLayout>

                <!-- Validity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🗓  Valid till 31 May 2026"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- ════════════════════════════════════
             BODY — white
             ════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- "What's included" label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="What's Included:"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_m"
                android:textStyle="bold" />

            <!-- Bullet: All Subjects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/positive" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="All Subjects — Class 6 to 12"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_m" />
            </LinearLayout>

            <!-- Bullet: Expert Faculty -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/positive" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Expert Faculty &amp; Live Classes"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_m" />
            </LinearLayout>

            <!-- Bullet: Test Series -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/positive" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Online &amp; Offline Test Series"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_m" />
            </LinearLayout>

            <!-- Bullet: Study Material -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/positive" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Study Material, Notes &amp; Mind Maps"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_m" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/stroke_minimal" />

            <!-- "Don't show again" checkbox -->
            <CheckBox
                android:id="@+id/cb_dont_show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:buttonTint="@color/reliance_blue"
                android:text="Don't show this again"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_s" />

            <!-- Enroll Now button -->
            <Button
                android:id="@+id/btn_enroll_now"
                style="@style/Saraswati.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_l"
                android:layout_marginBottom="12dp"
                android:text="Enroll Now  →" />

            <!-- Maybe Later link -->
            <TextView
                android:id="@+id/btn_maybe_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:padding="@dimen/space_xs"
                android:text="Maybe Later"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_m" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
